# Copy these into Netlify > Site configuration > Environment variables (do NOT commit real values)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# 24+ random characters. Must be identical to ACCESS_KEY in Code.gs.
SCRIPT_KEY=put-a-long-random-secret-here-same-as-ACCESS_KEY-in-Code.gs
# 32+ random characters, used to sign login sessions. Changing it logs everybody out.
SESSION_SECRET=put-another-long-random-secret-here
# Optional: how many hours a login lasts (1 to 24, default 8)
SESSION_HOURS=8
# Staff IDs and passwords are NOT set here. They live in the "Users" tab of the Google Sheet.
